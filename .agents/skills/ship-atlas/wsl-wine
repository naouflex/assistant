#!/usr/bin/env python3
# Stands in for `wine` under WSL: runs the Windows .exe directly and converts Linux
# paths in its arguments. Some tools resolve paths through a drive letter, so the
# distro is mapped to Z: for the duration of the call.
import os, re, subprocess, sys

def win(p):
    return subprocess.check_output(["wslpath", "-w", p], text=True).strip()

def conv(arg):
    if arg.startswith("/") and os.path.exists(arg):
        return win(arg)
    return re.sub(r"(?<=[=:])(/(?:home|tmp)/[^\s;\"]*)", lambda m: win(m.group(1)) if os.path.exists(os.path.dirname(m.group(1))) else m.group(1), arg)

args = sys.argv[1:]
if args and args[0] in ("--version", "wineboot"):
    print("wine-shim")
    sys.exit(0)
exe, rest = args[0], [conv(a) for a in args[1:]]
os.chmod(exe, 0o755)
share = r"\\wsl.localhost" + "\\" + os.environ["WSL_DISTRO_NAME"]
subprocess.call(["cmd.exe", "/c", "net", "use", "Z:", share], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
try:
    code = subprocess.call([exe, *rest])
finally:
    subprocess.call(["cmd.exe", "/c", "net", "use", "Z:", "/delete", "/y"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
sys.exit(code)
