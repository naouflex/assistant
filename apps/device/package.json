{
  "name": "@atlas/device",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless Atlas computer: lets an Atlas server's bots use this Linux machine.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/device/src"
  },
  "devDependencies": {
    "@atlas/adapters": "workspace:*",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
