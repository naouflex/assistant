[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/atlas/backup.env
ExecStart=/usr/local/sbin/atlas-host-check
StateDirectory=atlas/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/atlas/alerts
ProtectHome=true
PrivateTmp=true
